---
import Icon from "./Icon.astro";
import { useTranslations } from "@/i18n/utils";
import type { Locale } from "@/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<button
  id="theme-toggle"
  class="theme-toggle"
  aria-label={t("a11y.toggleTheme")}
  aria-pressed="false"
  type="button"
>
  <Icon name="lucide:sun" size={16} class="icon-sun" />
  <Icon name="lucide:moon" size={16} class="icon-moon" />
</button>

<script>
  function applyTheme(theme: "light" | "dark") {
    document.documentElement.dataset.theme = theme;
    try {
      localStorage.setItem("theme", theme);
    } catch {
      /* storage may be unavailable */
    }
  }

  function syncPressed(btn: HTMLElement) {
    const isDark = document.documentElement.dataset.theme === "dark";
    btn.setAttribute("aria-pressed", String(isDark));
  }

  function bindThemeToggle() {
    const btn = document.getElementById("theme-toggle");
    if (!btn || btn.dataset.bound === "1") return;
    btn.dataset.bound = "1";
    syncPressed(btn);
    btn.addEventListener("click", () => {
      const current =
        document.documentElement.dataset.theme === "dark" ? "dark" : "light";
      applyTheme(current === "dark" ? "light" : "dark");
      syncPressed(btn);
    });
  }

  bindThemeToggle();
  document.addEventListener("astro:page-load", bindThemeToggle);
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: var(--border-w) solid var(--color-border);
    background: var(--color-bg-soft);
    color: var(--color-text);
    cursor: pointer;
  }
  .theme-toggle:hover {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
  .icon-moon {
    display: none;
  }
  :global([data-theme="dark"]) .icon-sun {
    display: none;
  }
  :global([data-theme="dark"]) .icon-moon {
    display: inline-block;
  }
</style>
