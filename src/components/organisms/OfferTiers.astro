---
import SectionLabel from "@/components/atoms/SectionLabel.astro";
import Highlight from "@/components/atoms/Highlight.astro";
import OfferTierCard from "@/components/molecules/OfferTierCard.astro";
import { offerTiers } from "@/data/offer";
import { useTranslations } from "@/i18n/utils";
import type { Locale } from "@/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="section">
  <SectionLabel number="01">{t("offer.label")}</SectionLabel>
  <h2><Highlight>{t("offer.heading")}</Highlight></h2>
  <div class="tiers">
    {offerTiers.map((tier) => <OfferTierCard tier={tier} locale={locale} />)}
  </div>
</section>

<style>
  .section {
    padding: 40px 48px;
    border-bottom: var(--border-w) solid var(--color-border);
    max-width: var(--container-content);
    margin: 0 auto;
  }
  .section h2 {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 12px 0 18px;
    line-height: 1;
  }
  .tiers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 20px;
    align-items: start;
  }
  @media (max-width: 860px) {
    .tiers {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 720px) {
    .section {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
</style>
