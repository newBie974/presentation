---
import AppCell from "@/components/molecules/AppCell.astro";
import Highlight from "@/components/atoms/Highlight.astro";
import { projects } from "@/data/projects";
import type { Locale } from "@/types";
import { useTranslations } from "@/i18n/utils";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const liveCount = projects.filter((p) => p.status === "live").length;

const headingFR = { pre: "Ce que je ", hl: "construis" };
const headingEN = { pre: "What I'm ", hl: "building" };
const heading = locale === "fr" ? headingFR : headingEN;
---

<section id="apps" class="apps" data-reveal>
  <header class="head">
    <h2>
      {heading.pre}<Highlight>{heading.hl}</Highlight><span
        class="emoji"
        aria-hidden="true">🚀</span
      >
    </h2>
    <span class="count"
      >{liveCount.toString().padStart(2, "0")}
      {t("status.live").toUpperCase()}</span
    >
  </header>
  <fieldset class="filters">
    <legend class="sr-only">{t("filter.legend")}</legend>
    <input
      class="sr-only"
      type="radio"
      name="appfilter"
      id="appfilter-all"
      checked
    />
    <label for="appfilter-all">{t("filter.all")}</label>
    <input class="sr-only" type="radio" name="appfilter" id="appfilter-app" />
    <label for="appfilter-app">{t("filter.app")}</label>
    <input class="sr-only" type="radio" name="appfilter" id="appfilter-web" />
    <label for="appfilter-web">{t("filter.web")}</label>
  </fieldset>
  <div class="grid">
    {projects.map((project) => <AppCell project={project} locale={locale} />)}
  </div>
</section>

<style>
  .apps {
    padding: 40px 48px;
    border-bottom: var(--border-w) solid var(--color-border);
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 16px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .filters {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    border: 0;
    padding: 0;
    margin: 0 0 24px;
  }
  .filters label {
    padding: 5px 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    cursor: pointer;
    transition:
      background 120ms ease,
      color 120ms ease;
  }
  .filters label:hover {
    color: var(--color-text);
  }
  .filters input:checked + label {
    background: var(--color-strong-bg);
    color: var(--color-strong-fg);
    border-color: var(--color-strong-bg);
  }
  .filters input:focus-visible + label {
    box-shadow: 0 0 0 2px var(--color-accent);
  }
  /* CSS-only filtering: the checked radio hides the non-matching cells */
  .apps:has(#appfilter-app:checked) .grid > :global([data-type="web"]),
  .apps:has(#appfilter-web:checked) .grid > :global([data-type="app"]) {
    display: none;
  }
  h2 {
    font-size: clamp(24px, 4vw, 32px);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0;
    line-height: 1;
  }
  .count {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 3px 8px;
    background: var(--color-strong-bg);
    color: var(--color-strong-fg);
  }
  .emoji {
    display: inline-block;
    margin-left: 8px;
    font-size: 0.85em;
    vertical-align: baseline;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 18px;
  }
  @media (max-width: 720px) {
    .apps {
      padding: 24px 20px;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
