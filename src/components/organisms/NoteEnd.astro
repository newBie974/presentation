---
import { Image } from "astro:assets";
import NoteRow from "@/components/molecules/NoteRow.astro";
import SectionLabel from "@/components/atoms/SectionLabel.astro";
import avatar from "@/assets/avatar.png";
import { profile } from "@/data/profile";
import { useTranslations } from "@/i18n/utils";
import type { NoteEntry } from "@/lib/notes";
import type { Locale } from "@/types";

interface Props {
  locale: Locale;
  related: NoteEntry[];
}

const { locale, related } = Astro.props;
const t = useTranslations(locale);
---

<aside class="note-end">
  {
    related.length > 0 && (
      <section class="related" aria-label={t("note.readNext")}>
        <SectionLabel>{t("note.readNext")}</SectionLabel>
        {related.map((note) => (
          <NoteRow note={note} locale={locale} showExcerpt={false} />
        ))}
      </section>
    )
  }

  <section class="cta-card">
    <Image src={avatar} alt={`${profile.name}`} width={56} height={56} />
    <div class="who">
      <p class="name">{profile.name}</p>
      <p class="line">{profile.tagline[locale]}</p>
    </div>
    <div class="actions">
      <span class="lead">{t("note.ctaLead")}</span>
      <a class="book" href={t.path("work")}>{t("cta.bookCall")} →</a>
    </div>
  </section>
</aside>

<style>
  .note-end {
    max-width: var(--container-content);
    margin: 0 auto;
    padding: 0 48px 56px;
  }
  .related {
    margin-bottom: 40px;
  }
  .cta-card {
    display: grid;
    grid-template-columns: 56px 1fr auto;
    gap: 18px;
    align-items: center;
    padding: 20px;
    background: linear-gradient(
      180deg,
      var(--color-bg-raised),
      var(--color-bg-soft)
    );
    border: var(--border-w) solid var(--color-border);
    border-radius: var(--radius-card);
  }
  .cta-card :global(img) {
    border: var(--border-w) solid var(--color-border);
    border-radius: var(--radius-base);
  }
  .name {
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .line {
    font-size: 13px;
    color: var(--color-text-muted);
    margin: 2px 0 0;
  }
  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }
  .lead {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-muted);
  }
  .book {
    display: inline-flex;
    padding: 9px 14px;
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-radius: var(--radius-base);
    box-shadow: 0 0 24px
      color-mix(in srgb, var(--color-accent) 25%, transparent);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    transition: filter 120ms ease-out;
  }
  .book:hover {
    filter: brightness(1.08);
  }
  @media (max-width: 640px) {
    .note-end {
      padding: 0 20px 40px;
    }
    .cta-card {
      grid-template-columns: 56px 1fr;
    }
    .actions {
      grid-column: 1 / -1;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
