---
import SectionLabel from "@/components/atoms/SectionLabel.astro";
import Icon from "@/components/atoms/Icon.astro";
import { supportOffers } from "@/data/offer";
import { useTranslations } from "@/i18n/utils";
import type { Locale } from "@/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="section support">
  <SectionLabel>{t("offer.supportLabel")}</SectionLabel>
  <h2 class="sub">{t("offer.supportHeading")}</h2>
  <ul class="rows" role="list">
    {
      supportOffers.map((offer) => (
        <li class="row">
          <Icon name={offer.icon} size={18} />
          <div class="body">
            <p class="name">{offer.name[locale]}</p>
            <p class="note">{offer.note[locale]}</p>
          </div>
          <span class="price">{offer.price[locale]}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .section {
    padding: 40px 48px;
    border-bottom: var(--border-w) solid var(--color-border);
    max-width: var(--container-content);
    margin: 0 auto;
  }
  .support .sub {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 12px 0 0;
    line-height: 1.1;
  }
  .rows {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
  }
  .row {
    display: grid;
    grid-template-columns: 24px 1fr auto;
    gap: 14px;
    align-items: center;
    padding: 14px 0;
    border-top: 1px solid var(--color-border);
  }
  .name {
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .note {
    font-size: 12.5px;
    color: var(--color-text-muted);
    margin: 2px 0 0;
  }
  .price {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
  }
  @media (max-width: 720px) {
    .section {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
  @media (max-width: 640px) {
    .row {
      grid-template-columns: 24px 1fr;
    }
    .price {
      grid-column: 2 / -1;
      margin-top: 2px;
    }
  }
</style>
