---
import { Image } from "astro:assets";
import Icon from "@/components/atoms/Icon.astro";
import type { Project, Locale } from "@/types";
import { useTranslations } from "@/i18n/utils";

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const t = useTranslations(locale);

const statusLabel =
  project.status === "live" ? t("status.live") : t("status.building");
const platformLabel = project.platform.map((p) => p.toUpperCase()).join("+");
const websiteLabel = locale === "fr" ? "Site" : "Website";
const appStoreHint = locale === "fr" ? "Télécharger sur" : "Download on";
const playStoreHint = locale === "fr" ? "Disponible sur" : "Get it on";
---

<article class="cell">
  <a
    class="logo-link"
    href={project.url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`${project.title} — ${websiteLabel}`}
  >
    <div class="logo">
      {
        project.logo && (
          <Image
            src={project.logo}
            alt={`${project.title} logo`}
            width={96}
            height={96}
          />
        )
      }
    </div>
  </a>
  <h3 class="name">
    <a href={project.url} target="_blank" rel="noopener noreferrer">
      {project.title}
    </a>
  </h3>
  <p class="desc">{project.tagline[locale]}</p>
  <ul class="tech" role="list">
    {project.techStack.slice(0, 3).map((tech) => <li>{tech}</li>)}
  </ul>
  <p class="status">
    <span class="dot" aria-hidden="true"></span>{statusLabel.toUpperCase()} · {
      platformLabel
    }
  </p>

  <div class="ctas">
    {
      project.appStoreUrl && (
        <a
          class="badge apple"
          href={project.appStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="simple-icons:apple" size={18} />
          <span class="badge-text">
            <span class="hint">{appStoreHint}</span>
            <span class="main">App Store</span>
          </span>
        </a>
      )
    }
    {
      project.playStoreUrl && (
        <a
          class="badge google"
          href={project.playStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="simple-icons:googleplay" size={16} />
          <span class="badge-text">
            <span class="hint">{playStoreHint}</span>
            <span class="main">Google Play</span>
          </span>
        </a>
      )
    }
    {
      !project.appStoreUrl && !project.playStoreUrl && (
        <a
          class="website-link"
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {websiteLabel.toUpperCase()} →
        </a>
      )
    }
  </div>
</article>

<style>
  .cell {
    display: flex;
    flex-direction: column;
    padding: 20px;
    background: var(--color-bg-soft);
    border-right: var(--border-w) solid var(--color-border);
    color: var(--color-text);
  }
  .cell:last-child {
    border-right: none;
  }
  .logo-link {
    display: inline-block;
    width: 48px;
  }
  .logo {
    width: 48px;
    height: 48px;
    background: var(--color-text);
    border: var(--border-w) solid var(--color-border);
    margin-bottom: 14px;
    overflow: hidden;
    transition: background 150ms ease-out;
  }
  .logo-link:hover .logo {
    background: var(--color-accent);
  }
  .logo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .name {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 4px;
  }
  .name a {
    color: inherit;
    text-decoration: none;
  }
  .name a:hover {
    background: var(--color-accent);
    color: var(--color-on-accent);
    padding: 0 4px;
    margin: 0 -4px;
  }
  .desc {
    font-size: 12px;
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0 0 12px;
  }
  .tech {
    list-style: none;
    margin: 0 0 12px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .tech li {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--color-text-muted);
    padding: 3px 6px;
    background: var(--color-bg);
  }
  .status {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-success);
    text-transform: uppercase;
  }
  .status .dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    background: var(--color-success);
    margin-right: 4px;
    vertical-align: middle;
  }

  .ctas {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    background: #0a0a0a;
    color: #f6f6f4;
    border: var(--border-w) solid #0a0a0a;
    text-decoration: none;
    transition: background 150ms ease-out;
  }
  .badge:hover {
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-color: var(--color-accent);
  }
  .badge-text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }
  .hint {
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .main {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .website-link {
    display: inline-block;
    padding: 8px 10px;
    background: var(--color-bg);
    color: var(--color-text);
    border: var(--border-w) solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    transition: background 150ms ease-out;
  }
  .website-link:hover {
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-color: var(--color-accent);
  }
</style>
