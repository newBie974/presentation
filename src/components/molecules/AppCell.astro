---
import { Image } from "astro:assets";
import Icon from "@/components/atoms/Icon.astro";
import type { Project, Locale } from "@/types";
import { useTranslations } from "@/i18n/utils";

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const t = useTranslations(locale);

const statusLabel =
  project.status === "live" ? t("status.live") : t("status.building");
const isMobileApp = project.platform.some(
  (p) => p === "ios" || p === "android",
);
const projectType = isMobileApp ? "app" : "web";
const platformLabel = project.platform.map((p) => p.toUpperCase()).join("+");
const visitLabel = t("cta.visitSite");
const appStoreHint = locale === "fr" ? "Télécharger sur" : "Download on";
const playStoreHint = locale === "fr" ? "Disponible sur" : "Get it on";
---

<article class="cell" data-type={projectType}>
  <a
    class="logo-link"
    href={project.url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`${project.title} — ${visitLabel}`}
  >
    <div class="logo">
      {
        project.logo && (
          <Image
            src={project.logo}
            alt={`${project.title} logo`}
            width={96}
            height={96}
          />
        )
      }
    </div>
  </a>
  <h3 class="name">
    <a href={project.url} target="_blank" rel="noopener noreferrer">
      {project.title}
    </a>
  </h3>
  <p class="desc">{project.tagline[locale]}</p>
  <ul class="tech" role="list">
    {project.techStack.slice(0, 3).map((tech) => <li>{tech}</li>)}
  </ul>
  <p class="status" data-status={project.status}>
    <span class="dot" aria-hidden="true"></span>{statusLabel.toUpperCase()} · {
      platformLabel
    }
  </p>

  <div class="ctas">
    {
      project.appStoreUrl && (
        <a
          class="badge apple"
          href={project.appStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="simple-icons:apple" size={18} />
          <span class="badge-text">
            <span class="hint">{appStoreHint}</span>
            <span class="main">App Store</span>
          </span>
        </a>
      )
    }
    {
      project.playStoreUrl && (
        <a
          class="badge google"
          href={project.playStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="simple-icons:googleplay" size={16} />
          <span class="badge-text">
            <span class="hint">{playStoreHint}</span>
            <span class="main">Google Play</span>
          </span>
        </a>
      )
    }
    {
      !project.appStoreUrl && !project.playStoreUrl && (
        <a
          class="website-link"
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {visitLabel} →
        </a>
      )
    }
  </div>
</article>

<style>
  .cell {
    display: flex;
    flex-direction: column;
    padding: 20px;
    background: var(--color-bg-soft);
    border: var(--border-w) solid var(--color-border);
    color: var(--color-text);
    transition:
      transform 120ms ease,
      box-shadow 120ms ease;
  }
  .cell:hover {
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 0 var(--color-accent);
  }
  .logo-link {
    display: inline-block;
    width: 52px;
  }
  .logo {
    width: 52px;
    height: 52px;
    background: var(--color-bg);
    border: var(--border-w) solid var(--color-border);
    margin-bottom: 16px;
    overflow: hidden;
  }
  .logo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .name {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 5px;
  }
  .name a {
    color: inherit;
    text-decoration: none;
  }
  .name a:hover {
    background: var(--color-accent);
    color: var(--color-on-accent);
    padding: 0 4px;
    margin: 0 -4px;
    border-radius: 5px;
  }
  .desc {
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin: 0 0 14px;
  }
  .tech {
    list-style: none;
    margin: 0 0 14px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
  .tech li {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-muted);
    padding: 4px 8px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    align-self: flex-start;
    margin: 0 0 16px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-success);
  }
  .status[data-status="building"] {
    color: var(--color-building);
  }
  .status .dot {
    width: 7px;
    height: 7px;
    background: currentColor;
  }

  .ctas {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 12px;
    background: var(--color-inverse-bg);
    color: var(--color-inverse-fg);
    border: var(--border-w) solid var(--color-inverse-bg);
    text-decoration: none;
    transition: background 120ms ease-out;
  }
  .badge:hover {
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-color: var(--color-accent);
  }
  .badge-text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }
  .hint {
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .main {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .website-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 14px;
    background: var(--color-text);
    color: var(--color-bg);
    border: var(--border-w) solid var(--color-text);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    text-align: center;
    transition:
      background 120ms ease-out,
      color 120ms ease-out;
  }
  .website-link:hover {
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-color: var(--color-accent);
  }
</style>
