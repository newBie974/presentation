---
import { Image } from "astro:assets";
import Icon from "@/components/atoms/Icon.astro";
import type { Project, Locale } from "@/types";
import { useTranslations, localizePath } from "@/i18n/utils";
import { appDetails } from "@/data/appDetails";

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const t = useTranslations(locale);

// Apps with an on-site detail page get an internal link (SEO + funnel); others
// fall back to their external site.
const detailPath = appDetails[project.slug]
  ? `${localizePath("apps", locale)}/${project.slug}`
  : null;
const primaryHref = detailPath ?? project.url;
const isExternal = detailPath === null;

const statusLabel = t(
  project.status === "archived"
    ? "status.archived"
    : project.status === "live"
      ? "status.live"
      : "status.building",
);
const isMobileApp = project.platform.some(
  (p) => p === "ios" || p === "android",
);
const projectType = isMobileApp ? "app" : "web";
const platformLabel = project.platform.map((p) => p.toUpperCase()).join("+");
const visitLabel = t("cta.visitSite");
const appStoreHint = t("apps.downloadOn");
const playStoreHint = t("apps.getItOn");
---

<article class="cell" data-type={projectType}>
  <a
    class="logo-link"
    href={primaryHref}
    target={isExternal ? "_blank" : undefined}
    rel={isExternal ? "noopener noreferrer" : undefined}
    aria-label={`${project.title} — ${visitLabel}`}
  >
    <div class="logo">
      {
        project.logo && (
          <Image
            src={project.logo}
            alt={`${project.title} logo`}
            width={96}
            height={96}
          />
        )
      }
    </div>
  </a>
  <h3 class="name">
    <a
      href={primaryHref}
      target={isExternal ? "_blank" : undefined}
      rel={isExternal ? "noopener noreferrer" : undefined}
    >
      {project.title}
    </a>
  </h3>
  <p class="desc">{project.tagline[locale]}</p>
  <ul class="tech" role="list">
    {project.techStack.slice(0, 3).map((tech) => <li>{tech}</li>)}
  </ul>
  <p class="status" data-status={project.status}>
    <span class="dot" aria-hidden="true"></span>{statusLabel.toUpperCase()} · {
      platformLabel
    }
  </p>

  <div class="ctas">
    {
      project.appStoreUrl && (
        <a
          class="badge apple"
          href={project.appStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="simple-icons:apple" size={18} />
          <span class="badge-text">
            <span class="hint">{appStoreHint}</span>
            <span class="main">App Store</span>
          </span>
        </a>
      )
    }
    {
      project.playStoreUrl && (
        <a
          class="badge google"
          href={project.playStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="simple-icons:googleplay" size={16} />
          <span class="badge-text">
            <span class="hint">{playStoreHint}</span>
            <span class="main">Google Play</span>
          </span>
        </a>
      )
    }
    {
      !project.appStoreUrl && !project.playStoreUrl && (
        <a
          class="website-link"
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {visitLabel} →
        </a>
      )
    }
  </div>
</article>

<style>
  .cell {
    display: flex;
    flex-direction: column;
    padding: 22px;
    background: linear-gradient(
      180deg,
      var(--color-bg-raised),
      var(--color-bg-soft)
    );
    border: var(--border-w) solid var(--color-border);
    border-radius: var(--radius-card);
    color: var(--color-text);
    transition:
      transform 120ms ease,
      border-color 120ms ease;
  }
  .cell:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent-dim);
  }
  .logo-link {
    display: inline-block;
    width: 52px;
  }
  .logo {
    width: 52px;
    height: 52px;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border: var(--border-w) solid var(--color-border);
    border-radius: var(--radius-base);
    margin-bottom: 16px;
    overflow: hidden;
  }
  .logo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .name {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 5px;
  }
  .name a {
    color: inherit;
    text-decoration: none;
  }
  .name a:hover {
    color: var(--color-accent);
  }
  .desc {
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin: 0 0 14px;
  }
  .tech {
    list-style: none;
    margin: 0 0 14px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
  .tech li {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-faint);
    padding: 4px 8px;
    background: var(--color-bg);
    border: var(--border-w) solid var(--color-border);
    border-radius: 6px;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    align-self: flex-start;
    margin: 0 0 16px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-success);
  }
  .status[data-status="building"] {
    color: var(--color-building);
  }
  .status[data-status="archived"] {
    color: var(--color-text-muted);
  }
  .status .dot {
    width: 7px;
    height: 7px;
    background: currentColor;
  }

  .ctas {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 12px;
    background: var(--color-bg-raised);
    color: var(--color-text);
    border: var(--border-w) solid var(--color-border);
    border-radius: var(--radius-base);
    text-decoration: none;
    transition:
      border-color 120ms ease-out,
      color 120ms ease-out;
  }
  .badge:hover {
    border-color: var(--color-accent-dim);
    color: var(--color-accent);
  }
  .badge-text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }
  .hint {
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .main {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .website-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 14px;
    background: var(--color-accent);
    color: var(--color-on-accent);
    border: var(--border-w) solid var(--color-accent);
    border-radius: var(--radius-base);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    text-align: center;
    transition: filter 120ms ease-out;
  }
  .website-link:hover {
    filter: brightness(1.08);
  }
</style>
