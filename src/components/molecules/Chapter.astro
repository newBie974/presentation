---
import type { Chapter, Locale } from "@/types";

interface Props {
  chapter: Chapter;
  locale: Locale;
}
const { chapter, locale } = Astro.props;

const stackLabel = locale === "fr" ? "STACK" : "STACK";
---

<article class="chapter">
  <header class="head">
    <span class="years">{chapter.yearsLabel}</span>
    <h3>{chapter.title[locale]}</h3>
    <p class="role">{chapter.role[locale]}</p>
  </header>

  <p class="body">{chapter.body[locale]}</p>

  {
    chapter.highlights && chapter.highlights.length > 0 && (
      <ul class="highlights">
        {chapter.highlights.map((h) => (
          <li>
            <span class="bullet" aria-hidden="true">
              →
            </span>
            <span>{h[locale]}</span>
          </li>
        ))}
      </ul>
    )
  }

  {
    chapter.technologies && chapter.technologies.length > 0 && (
      <p class="stack">
        <span class="stack-label">{stackLabel}</span>
        <span class="tech">{chapter.technologies.join(" · ")}</span>
      </p>
    )
  }
</article>

<style>
  .chapter {
    padding: 28px 0;
    border-top: 1px dashed var(--color-border);
  }
  .chapter:first-of-type {
    border-top: none;
    padding-top: 0;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 14px;
  }
  .years {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  h3 {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
    line-height: 1.2;
  }
  .role {
    font-size: 13px;
    color: var(--color-text-muted);
    margin: 0;
  }

  .body {
    font-size: 14px;
    line-height: 1.7;
    margin: 0 0 14px;
  }

  .highlights {
    list-style: none;
    padding: 0;
    margin: 0 0 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .highlights li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 10px;
    font-size: 13px;
    line-height: 1.65;
  }
  .bullet {
    font-family: var(--font-mono);
    color: var(--color-accent);
    font-weight: 700;
  }
  :global([data-theme="dark"]) .bullet {
    color: var(--color-accent);
  }

  .stack {
    margin: 6px 0 0;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.65;
    color: var(--color-text);
  }
  .stack-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--color-text-muted);
    margin-right: 12px;
  }
  .tech {
    color: var(--color-text);
  }
</style>
