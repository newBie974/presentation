---
import type { Chapter, Locale } from "@/types";

interface Props {
  chapter: Chapter;
  locale: Locale;
}
const { chapter, locale } = Astro.props;

const stackLabel = locale === "fr" ? "STACK" : "STACK";
---

<article class="chapter">
  <header class="head">
    <span class="years">{chapter.yearsLabel}</span>
    <h3>{chapter.title[locale]}</h3>
    <p class="role">{chapter.role[locale]}</p>
  </header>

  <p class="body">{chapter.body[locale]}</p>

  {
    chapter.highlights && chapter.highlights.length > 0 && (
      <ul class="highlights">
        {chapter.highlights.map((h) => (
          <li>
            <span class="bullet" aria-hidden="true">
              →
            </span>
            <span>{h[locale]}</span>
          </li>
        ))}
      </ul>
    )
  }

  {
    chapter.technologies && chapter.technologies.length > 0 && (
      <div class="stack">
        <span class="stack-label">{stackLabel}</span>
        <ul class="tech" aria-label="Technologies">
          {chapter.technologies.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      </div>
    )
  }
</article>

<style>
  .chapter {
    padding: 28px 0;
    border-top: 1px dashed var(--color-border);
  }
  .chapter:first-of-type {
    border-top: none;
    padding-top: 0;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 14px;
  }
  .years {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  h3 {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
    line-height: 1.2;
  }
  .role {
    font-size: 13px;
    color: var(--color-text-muted);
    margin: 0;
  }

  .body {
    font-size: 14px;
    line-height: 1.7;
    margin: 0 0 14px;
  }

  .highlights {
    list-style: none;
    padding: 0;
    margin: 0 0 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .highlights li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 10px;
    font-size: 13px;
    line-height: 1.65;
  }
  .bullet {
    font-family: var(--font-mono);
    color: var(--color-accent);
    font-weight: 700;
  }
  :global([data-theme="dark"]) .bullet {
    color: var(--color-accent);
  }

  .stack {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 16px;
    align-items: start;
    padding-top: 6px;
  }
  .stack-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--color-text-muted);
    padding-top: 4px;
  }
  .tech {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .tech li {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text);
    padding: 3px 8px;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
  }

  @media (max-width: 720px) {
    .stack {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
