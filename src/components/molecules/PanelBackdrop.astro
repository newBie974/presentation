---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

/** Les trois calques décoratifs d'un panneau de vitrine : un halo diffus, la
 *  capture floutée en soft-light qui teinte le fond, et un vignettage. Ils se
 *  placent derrière le contenu et héritent des variables du panneau parent. */
interface Props {
  haze: ImageMetadata;
}

const { haze } = Astro.props;
---

<div class="glow" aria-hidden="true"></div>
<Image class="haze" src={haze} alt="" aria-hidden="true" />
<div class="vignette" aria-hidden="true"></div>

<style>
  .glow {
    position: absolute;
    inset-inline-end: -6%;
    inset-block-start: -28%;
    inline-size: 60%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: color-mix(in srgb, var(--panel-fg) 34%, transparent);
    filter: blur(110px);
    z-index: -2;
  }
  .haze {
    position: absolute;
    inset-inline-end: -14%;
    inset-block-start: -30%;
    inline-size: 82%;
    height: auto;
    filter: blur(80px);
    opacity: 0.3;
    mix-blend-mode: soft-light;
    z-index: -2;
  }
  .vignette {
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 200px 30px rgb(10 12 20 / 0.32);
    z-index: -1;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .glow {
        animation: glow-swell linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 50%;
      }
      @keyframes glow-swell {
        from {
          transform: scale(0.82);
          opacity: 0.3;
        }
        to {
          transform: none;
          opacity: 1;
        }
      }
    }
  }

  @media (max-width: 900px) {
    .glow {
      inset-block-start: 40%;
      inline-size: 120%;
    }
  }
</style>
