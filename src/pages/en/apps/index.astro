---
import MainLayout from "@/layouts/MainLayout.astro";
import Nav from "@/components/organisms/Nav.astro";
import Footer from "@/components/organisms/Footer.astro";
import Highlight from "@/components/atoms/Highlight.astro";
import AppsShowcase from "@/components/organisms/AppsShowcase.astro";
import CollabBand from "@/components/organisms/CollabBand.astro";
import JsonLd from "@/components/atoms/JsonLd.astro";
import { useTranslations } from "@/i18n/utils";
import { buildPersonJsonLd, buildSoftwareAppJsonLd } from "@/lib/jsonLd";

const locale = "en" as const;
const t = useTranslations(locale);
const title = "What I've shipped — Aymeric Dijoux, iOS apps in production";
const description = t("showcase.pageDeck");
---

<MainLayout
  title={title}
  description={description}
  locale={locale}
  routeKey="apps"
>
  <Fragment slot="head">
    <JsonLd data={[buildPersonJsonLd(), ...buildSoftwareAppJsonLd()]} />
  </Fragment>
  <Nav slot="nav" locale={locale} current="apps" />

  <section class="page-hero">
    <h1>
      {t("showcase.pageTitleLead")}<Highlight>
        {t("showcase.pageTitleAccent")}
      </Highlight>.
    </h1>
    <p class="deck">{description}</p>
  </section>

  <AppsShowcase locale={locale} />

  <CollabBand locale={locale} />
  <Footer slot="footer" locale={locale} />
</MainLayout>

<style>
  .page-hero {
    max-width: var(--container-content);
    margin: 0 auto;
    padding: 64px 48px 40px;
  }
  h1 {
    margin: 14px 0;
    font-size: clamp(32px, 6vw, 48px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .deck {
    margin: 0;
    max-width: 560px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  @media (max-width: 720px) {
    .page-hero {
      padding-inline: 20px;
    }
  }
</style>
