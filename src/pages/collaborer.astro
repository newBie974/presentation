---
import MainLayout from "@/layouts/MainLayout.astro";
import Nav from "@/components/organisms/Nav.astro";
import Footer from "@/components/organisms/Footer.astro";
import SectionLabel from "@/components/atoms/SectionLabel.astro";
import Highlight from "@/components/atoms/Highlight.astro";
import OfferTiers from "@/components/organisms/OfferTiers.astro";
import OfferSupport from "@/components/organisms/OfferSupport.astro";
import TrustBand from "@/components/organisms/TrustBand.astro";
import ProcessStep from "@/components/molecules/ProcessStep.astro";
import FAQItem from "@/components/molecules/FAQItem.astro";
import StatusBadge from "@/components/atoms/StatusBadge.astro";
import { faq } from "@/data/faq";
import { testimonials } from "@/data/testimonials";
import Testimonial from "@/components/molecules/Testimonial.astro";
import CalEmbed from "@/components/molecules/CalEmbed.astro";
import JsonLd from "@/components/atoms/JsonLd.astro";
import {
  buildPersonJsonLd,
  buildFAQJsonLd,
  buildProfessionalServiceJsonLd,
} from "@/lib/jsonLd";

const locale = "fr" as const;
const title =
  "Collaborer — Aymeric Dijoux, freelance builder IA · La Réunion & Paris";
const description =
  "Développeur freelance basé à La Réunion (974) et Paris, expert apps IA. Aymeric Dijoux prend 1 à 2 missions par semestre — mobile, web, prototype IA. Remote, prix fixes ou TJM, call intro gratuit de 30 min.";
const calcomUrl =
  import.meta.env.PUBLIC_CALCOM_URL ?? "https://cal.eu/aymeric-dijoux/intro";
const calLink = "aymeric-dijoux/intro";

const processSteps = [
  {
    roman: "i" as const,
    title: "Call intro (30 min, gratuit)",
    desc: "Tu m'expliques le projet, je te dis si je suis le bon profil et combien ça prend.",
  },
  {
    roman: "ii" as const,
    title: "Brief écrit (48h)",
    desc: "Je te renvoie un doc court : scope, timeline, jalons, prix fixe ou TJM.",
  },
  {
    roman: "iii" as const,
    title: "Kick-off & build",
    desc: "Daily ou hebdo en async (Slack/Linear). Démo chaque semaine. Code sur ton GitHub dès le jour 1.",
  },
  {
    roman: "iv" as const,
    title: "Ship & transition",
    desc: "Mise en prod + transmission propre (docs, Loom, repo clean). Support 2 semaines inclus.",
  },
];
---

<MainLayout
  title={title}
  description={description}
  locale={locale}
  routeKey="work"
>
  <Fragment slot="head">
    <JsonLd
      data={[
        buildPersonJsonLd(),
        buildProfessionalServiceJsonLd(locale),
        buildFAQJsonLd(faq.map((f) => ({ q: f.q[locale], a: f.a[locale] }))),
      ]}
    />
  </Fragment>
  <Nav slot="nav" locale={locale} current="work" />

  <section class="page-hero">
    <SectionLabel>COLLABORER</SectionLabel>
    <h1>
      Développeur freelance <Highlight>IA</Highlight> — ton produit du Figma au store.
    </h1>
    <p class="deck">
      Je conçois, développe et déploie ton app mobile ou web propulsée par l'IA,
      sans sous-traitance. Tu échanges direct avec la personne qui code.
    </p>
    <p class="values">
      Construire ensemble, pas juste coder pour toi. Basé à <Highlight
        >La Réunion</Highlight
      > & Paris, en remote partout — 1 à 2 missions par semestre.
    </p>
    <StatusBadge label="Dispo S2 2026 · 1 slot restant" />
  </section>

  <OfferTiers locale={locale} />
  <OfferSupport locale={locale} />
  <TrustBand locale={locale} />

  <section class="section">
    <SectionLabel number="02">COMMENT ÇA SE PASSE</SectionLabel>
    <h2>Le <Highlight>process</Highlight></h2>
    {
      processSteps.map((s) => (
        <ProcessStep roman={s.roman} title={s.title} desc={s.desc} />
      ))
    }
  </section>

  <section class="section">
    <SectionLabel number="03">ILS ONT BOSSÉ AVEC MOI</SectionLabel>
    <h2>Quelques <Highlight>témoignages</Highlight></h2>
    <div class="testimonials">
      {testimonials.map((t) => <Testimonial testimonial={t} locale={locale} />)}
    </div>
  </section>

  <section class="section">
    <SectionLabel number="04">FAQ</SectionLabel>
    <h2>Les questions <Highlight>qu'on me pose</Highlight></h2>
    {
      faq.map((item, i) => (
        <FAQItem q={item.q[locale]} a={item.a[locale]} open={i === 0} />
      ))
    }
  </section>

  <section class="section booking">
    <SectionLabel number="05">RÉSERVER UN CALL</SectionLabel>
    <h2>Choisis ton <Highlight>créneau</Highlight></h2>
    <p class="lead">
      30 minutes, gratuit, sans engagement. Si je suis pas le bon profil, je te
      le dirai et je te recommanderai quelqu'un.
    </p>
    <CalEmbed calLink={calLink} />
  </section>

  <section class="end-cta">
    <h2>Pas dispo sur ces créneaux ?</h2>
    <p>
      Écris-moi directement :
      <a href="mailto:aymeric@dijoux.dev">aymeric@dijoux.dev</a>
    </p>
    <p class="alt">
      Ou ouvre le calendrier en plein écran :
      <a href={calcomUrl} target="_blank" rel="noopener noreferrer"
        >cal.eu/aymeric-dijoux/intro</a
      >
    </p>
  </section>

  <Footer slot="footer" locale={locale} />
</MainLayout>

<style>
  .page-hero {
    padding: 64px 48px 32px;
    border-bottom: var(--border-w) solid var(--color-border);
    max-width: var(--container-content);
    margin: 0 auto;
  }
  h1 {
    font-size: clamp(32px, 6vw, 48px);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.04em;
    margin: 14px 0;
  }
  .deck {
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 560px;
    margin: 0 0 12px;
  }
  .values {
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-text-muted);
    max-width: 560px;
    margin: 0 0 20px;
  }
  .section {
    padding: 40px 48px;
    border-bottom: var(--border-w) solid var(--color-border);
    max-width: var(--container-content);
    margin: 0 auto;
  }
  .section h2 {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 12px 0 18px;
    line-height: 1;
  }
  .testimonials {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  @media (max-width: 720px) {
    .testimonials {
      grid-template-columns: 1fr;
    }
  }
  .booking .lead {
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0 0 20px;
    max-width: 580px;
  }
  .end-cta {
    max-width: var(--container-content);
    margin: 70px auto;
    padding: 44px 40px;
    color: var(--color-text);
    border: var(--border-w) solid var(--color-accent-dim);
    border-radius: var(--radius-band);
    background:
      radial-gradient(
        ellipse at top left,
        color-mix(in srgb, var(--color-accent) 8%, transparent),
        transparent 55%
      ),
      var(--color-bg-soft);
    text-align: center;
  }
  .end-cta h2 {
    font-size: clamp(24px, 5vw, 32px);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 14px;
    line-height: 1;
    color: var(--color-text);
  }
  .end-cta p {
    font-size: 14px;
    color: var(--color-text-muted);
    max-width: 460px;
    margin: 0 auto 20px;
    line-height: 1.6;
  }
  .end-cta a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .end-cta .alt {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-muted);
    margin-top: 12px;
  }
  @media (max-width: 720px) {
    .page-hero,
    .section {
      padding-left: 20px;
      padding-right: 20px;
    }
    .end-cta {
      margin: 40px 20px;
    }
  }
</style>
